{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "jwt_signing_key": {
        "value": "${AZURE_JWT_SIGNING_KEY}"
      },
      "postgres_password": {
        "value": "${AZURE_POSTGRES_PASSWORD}"
      },
      "postgres_username": {
        "value": "${AZURE_POSTGRES_USERNAME}"
      },
      "sendgrid_api_key": {
        "value": "${AZURE_SENDGRID_API_KEY}"
      },
      "sendgrid_from_email": {
        "value": "${AZURE_SENDGRID_FROM_EMAIL}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  