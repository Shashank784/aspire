@page "/search"

@attribute [StreamRendering(true)]
@rendermode InteractiveServer

@inject CatalogApiClient CatalogApiClient
@inject BasketActions BasketActions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Search Products</PageTitle>

<h1>Search Products</h1>

<p>Search our amazing outdoor products that you can purchase.</p>

<div class="form-group">
    <label for="search" class="form-label">Type your question:</label>
    <div class="input-group mb-3">
        <input type="text" id="search" class="form-control" @bind="searchTerm" placeholder="Enter search term..." />
        <button id="btnSearch" class="btn btn-primary" @onclick="DoSearch" type="submit">Search</button>
    </div>
    <hr />
</div>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else if (products.Count == 0)
{
    <p><em>No product found.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td><img height="80" width="80" src="@ProductImageResolver.Resolve(product)" /></td>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("C2")</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => AddToBasket(product)">Add to Basket</button>
                        @if (statusMessages.TryGetValue(product.Id, out var message))
                        {
                            <div class="small text-success">@message</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private string searchTerm = default!;
    private List<Product>? products = [];
    private readonly Dictionary<int, string> statusMessages = [];

    private async Task DoSearch(MouseEventArgs e)
    {
        await Task.Delay(500);
        products = await CatalogApiClient.SearchProducts(searchTerm);
    }

    private async Task AddToBasket(Product product)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.IsAuthenticated == true ? authState.User.Identity.Name : null;

        if (string.IsNullOrEmpty(userName))
        {
            NavigationManager.NavigateTo("/login?ReturnUrl=/search", forceLoad: true);
            return;
        }

        await BasketActions.AddToBasketAsync(userName, product);
        statusMessages[product.Id] = "Added to basket!";
    }
}
