@page "/order-confirmation"
@attribute [Authorize]
@using Orders.Models
@using WebApp.ApiClients
@inject OrdersApiClient OrdersApiClient

<PageTitle>Order Confirmation</PageTitle>

@if (order is null)
{
    <p><em>Order not found.</em></p>
}
else if (order.Status != OrderStatus.Paid)
{
    <h1>Payment processing...</h1>
    <p>We haven't heard back from the payment provider yet. This can take a few seconds — refresh this page shortly.</p>
}
else
{
    <h1>Thank you! Your order is confirmed.</h1>
    <p>Order #@order.Id &mdash; paid on @order.PaidAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC</p>

    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in order.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Price.ToString("C2")</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Price * item.Quantity).ToString("C2"))</td>
                </tr>
            }
        </tbody>
    </table>
    <p><strong>Total: @order.TotalAmount.ToString("C2")</strong></p>

    <a class="btn btn-primary" href="/downloads/invoice/@order.Id">Download Invoice</a>
    <a class="btn btn-secondary" href="/products">Continue Shopping</a>
}

@code {
    [SupplyParameterFromQuery]
    private int OrderId { get; set; }

    private Order? order;

    protected override async Task OnInitializedAsync()
    {
        order = await OrdersApiClient.GetOrder(OrderId);
    }
}
