@page "/basket"
@attribute [Authorize]
@rendermode InteractiveServer
@using Basket.Models
@using WebApp.ApiClients
@using WebApp.Authentication
@inject BasketApiClient BasketApiClient
@inject OrdersApiClient OrdersApiClient
@inject BasketActions BasketActions
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>My Basket</PageTitle>

<h1>My Basket</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (cart is null || cart.Items.Count == 0)
{
    <p><em>Your basket is empty.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Color</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in cart.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Color</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ChangeQuantityAsync(item.ProductId, -1))" disabled="@isUpdatingQuantity">-</button>
                        <span class="mx-2">@item.Quantity</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ChangeQuantityAsync(item.ProductId, 1))" disabled="@isUpdatingQuantity">+</button>
                    </td>
                    <td>@item.Price.ToString("C2")</td>
                    <td>@((item.Price * item.Quantity).ToString("C2"))</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => RemoveAsync(item.ProductId))" disabled="@isRemoving">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p><strong>Total: @cart.TotalPrice.ToString("C2")</strong></p>

    <button class="btn btn-primary" @onclick="CheckoutAsync" disabled="@isCheckingOut">
        @(isCheckingOut ? "Redirecting to payment..." : "Proceed to Checkout")
    </button>
}

@code {
    private ShoppingCart? cart;
    private string? errorMessage;
    private bool isCheckingOut;
    private bool isRemoving;
    private bool isUpdatingQuantity;

    protected override async Task OnInitializedAsync()
    {
        var userName = HttpContextAccessor.HttpContext?.User.Identity?.Name;
        if (!string.IsNullOrEmpty(userName))
        {
            cart = await BasketApiClient.GetBasket(userName);
        }
    }

    private async Task CheckoutAsync()
    {
        isCheckingOut = true;
        errorMessage = null;

        // IHttpContextAccessor isn't reliably available during interactive Blazor Server
        // event handlers, so the JWT is read from the (circuit-safe) authentication state
        // and passed through explicitly rather than relying on the ambient HttpContext.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var accessToken = authState.User.FindFirst(AuthClaimTypes.AccessToken)?.Value;

        var result = await OrdersApiClient.Checkout(accessToken);
        if (result is null)
        {
            errorMessage = "Failed to start checkout. Please try again.";
            isCheckingOut = false;
            return;
        }

        NavigationManager.NavigateTo(result.CheckoutUrl, forceLoad: true);
    }

    private async Task RemoveAsync(int productId)
    {
        isRemoving = true;
        errorMessage = null;

        // Same reasoning as CheckoutAsync: read from the circuit-safe auth state rather
        // than the ambient HttpContext, which isn't reliable during an interactive event.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        var accessToken = authState.User.FindFirst(AuthClaimTypes.AccessToken)?.Value;

        if (!string.IsNullOrEmpty(userName))
        {
            var success = await BasketActions.RemoveFromBasketAsync(userName, accessToken, productId);
            if (success)
            {
                cart = await BasketApiClient.GetBasket(userName, accessToken);
            }
            else
            {
                errorMessage = "Failed to remove item. Please try again.";
            }
        }

        isRemoving = false;
    }

    private async Task ChangeQuantityAsync(int productId, int delta)
    {
        isUpdatingQuantity = true;
        errorMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        var accessToken = authState.User.FindFirst(AuthClaimTypes.AccessToken)?.Value;

        if (!string.IsNullOrEmpty(userName))
        {
            var success = await BasketActions.ChangeQuantityAsync(userName, accessToken, productId, delta);
            if (success)
            {
                cart = await BasketApiClient.GetBasket(userName, accessToken);
            }
            else
            {
                errorMessage = "Failed to update quantity. Please try again.";
            }
        }

        isUpdatingQuantity = false;
    }
}
